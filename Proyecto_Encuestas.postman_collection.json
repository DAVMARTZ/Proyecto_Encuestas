{
  "info": {
    "name": "Proyecto Encuestas — API Collection Completa",
    "description": "Colección completa y exhaustiva para el Backend en Arquitectura Hexagonal + TypeORM + PostgreSQL.\n- Módulos: Roles, Usuarios (Auth & Perfil), Encuestas, Preguntas, Opciones de Respuesta, Respuestas y Estadísticas.\n- IDs autoincrementales numéricos.\n- Baja lógica sin borrado físico (status: 1 Activo, 0 Inactivo).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",    "value": "http://localhost:3000/api", "type": "string" },
    { "key": "userId",     "value": "1",                         "type": "string" },
    { "key": "roleId",     "value": "1",                         "type": "string" },
    { "key": "surveyId",   "value": "1",                         "type": "string" },
    { "key": "questionId", "value": "1",                         "type": "string" },
    { "key": "optionId",   "value": "1",                         "type": "string" },
    { "key": "token",      "value": "",                          "type": "string" }
  ],
  "item": [
    {
      "name": "🎭 Roles",
      "item": [
        {
          "name": "Listar todos los roles (Activos)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/roles"
          }
        },
        {
          "name": "Listar todos los roles (Incluye Inactivos)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/roles?includeInactive=true"
          }
        },
        {
          "name": "Obtener Rol por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/roles/{{roleId}}"
          }
        },
        {
          "name": "Crear rol",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.roleId) {",
                  "  pm.collectionVariables.set('roleId', json.roleId.toString());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/roles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"DOCENTE\",\n  \"description\": \"Profesor que puede evaluar y crear encuestas\"\n}"
            }
          }
        },
        {
          "name": "Actualizar rol",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/roles/{{roleId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"DOCENTE LIDER\",\n  \"description\": \"Coordinador y creador de encuestas\"\n}"
            }
          }
        },
        {
          "name": "Inactivar rol (Baja lógica)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/roles/{{roleId}}/deactivate"
          }
        },
        {
          "name": "Reactivar rol",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/roles/{{roleId}}/activate"
          }
        },
        {
          "name": "Eliminar rol (DELETE lógico sin borrado físico)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/roles/{{roleId}}"
          }
        }
      ]
    },
    {
      "name": "👤 Usuarios",
      "item": [
        {
          "name": "Crear Usuario con Foto en Base64",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.userId) {",
                  "  pm.collectionVariables.set('userId', json.userId.toString());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laura Morales\",\n  \"email\": \"laura.morales@universidad.edu.co\",\n  \"password\": \"Segura123!\",\n  \"avatarBase64\": \"data:image/jpeg;base64,\",\n  \"roleId\": 2\n}"
            }
          }
        },
        {
          "name": "Login (Iniciar Sesión y Obtener JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@encuestas.com\",\n  \"password\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Obtener Perfil Propio (GET /users/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Obtener Todos los Usuarios (Activos)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Obtener Todos los Usuarios (Incluye Inactivos)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users?includeInactive=true"
          }
        },
        {
          "name": "Obtener Usuario por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Obtener Usuario por Email",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/email/admin@encuestas.com"
          }
        },
        {
          "name": "Actualizar Usuario",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/users/{{userId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laura Morales Actualizada\"\n}"
            }
          }
        },
        {
          "name": "Inactivar Usuario (Baja Lógica PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/{{userId}}/deactivate"
          }
        },
        {
          "name": "Reactivar Usuario (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/{{userId}}/activate"
          }
        },
        {
          "name": "Eliminar Usuario (DELETE lógico)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "📋 Encuestas",
      "item": [
        {
          "name": "Crear Encuesta",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.surveyId) {",
                  "  pm.collectionVariables.set('surveyId', json.surveyId.toString());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/surveys",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Evaluación Docente Semestre 2026-2\",\n  \"description\": \"Evaluación sobre metodología pedagógica y acompañamiento del docente.\",\n  \"closeDate\": \"2026-12-20T23:59:59.000Z\",\n  \"userId\": 1\n}"
            }
          }
        },
        {
          "name": "Obtener Todas las Encuestas (Activas)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/surveys"
          }
        },
        {
          "name": "Obtener Encuesta por ID (con preguntas y opciones)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/surveys/{{surveyId}}"
          }
        },
        {
          "name": "Obtener Encuestas por Creador (GET /users/:userId/surveys)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/{{userId}}/surveys"
          }
        },
        {
          "name": "Actualizar Encuesta",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/surveys/{{surveyId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Evaluación Docente Semestre 2026-2 (Modificada)\",\n  \"description\": \"Nueva descripción actualizada\"\n}"
            }
          }
        },
        {
          "name": "Publicar Encuesta (Activar)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/surveys/{{surveyId}}/publish"
          }
        },
        {
          "name": "Inactivar Encuesta (Baja lógica)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/surveys/{{surveyId}}/deactivate"
          }
        },
        {
          "name": "Reactivar Encuesta",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/surveys/{{surveyId}}/activate"
          }
        },
        {
          "name": "Eliminar Encuesta (DELETE lógico)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/surveys/{{surveyId}}"
          }
        }
      ]
    },
    {
      "name": "❓ Preguntas",
      "item": [
        {
          "name": "Crear Pregunta de Selección Múltiple con Opciones",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.questionId) {",
                  "  pm.collectionVariables.set('questionId', json.questionId.toString());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/surveys/{{surveyId}}/questions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionText\": \"¿Cómo calificaría la puntualidad del docente?\",\n  \"questionType\": \"Seleccion Multiple\",\n  \"isRequired\": true,\n  \"displayOrder\": 1,\n  \"options\": [\n    { \"optionText\": \"Excelente\", \"displayOrder\": 1 },\n    { \"optionText\": \"Bueno\", \"displayOrder\": 2 },\n    { \"optionText\": \"Regular\", \"displayOrder\": 3 },\n    { \"optionText\": \"Deficiente\", \"displayOrder\": 4 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Crear Pregunta Abierta",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/surveys/{{surveyId}}/questions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionText\": \"¿Qué comentarios o sugerencias tiene para el docente?\",\n  \"questionType\": \"Abierta\",\n  \"isRequired\": false,\n  \"displayOrder\": 2\n}"
            }
          }
        },
        {
          "name": "Listar Preguntas de una Encuesta",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/surveys/{{surveyId}}/questions"
          }
        },
        {
          "name": "Obtener Pregunta por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/questions/{{questionId}}"
          }
        },
        {
          "name": "Actualizar Pregunta",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/questions/{{questionId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionText\": \"¿Cómo calificaría la puntualidad y disposición del docente?\",\n  \"isRequired\": true\n}"
            }
          }
        },
        {
          "name": "Inactivar Pregunta (Baja lógica)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/questions/{{questionId}}/deactivate"
          }
        },
        {
          "name": "Reactivar Pregunta",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/questions/{{questionId}}/activate"
          }
        },
        {
          "name": "Eliminar Pregunta (DELETE lógico)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/questions/{{questionId}}"
          }
        }
      ]
    },
    {
      "name": "🔘 Opciones de Respuesta",
      "item": [
        {
          "name": "Crear Opción de Respuesta para una Pregunta",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.optionId) {",
                  "  pm.collectionVariables.set('optionId', json.optionId.toString());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/questions/{{questionId}}/options",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"optionText\": \"No aplica / Sin opinión\",\n  \"displayOrder\": 5\n}"
            }
          }
        },
        {
          "name": "Listar Opciones de una Pregunta",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/questions/{{questionId}}/options"
          }
        },
        {
          "name": "Obtener Opción por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/options/{{optionId}}"
          }
        },
        {
          "name": "Actualizar Opción",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/options/{{optionId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"optionText\": \"Excelente (Destacado)\"\n}"
            }
          }
        },
        {
          "name": "Inactivar Opción (Baja lógica)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/options/{{optionId}}/deactivate"
          }
        },
        {
          "name": "Reactivar Opción",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/options/{{optionId}}/activate"
          }
        },
        {
          "name": "Eliminar Opción (DELETE lógico)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/options/{{optionId}}"
          }
        }
      ]
    },
    {
      "name": "📝 Respuestas y Estadísticas",
      "item": [
        {
          "name": "Enviar Respuestas de Encuesta",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/surveys/{{surveyId}}/responses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"surveyId\": 1,\n  \"userId\": 1,\n  \"details\": [\n    {\n      \"questionId\": 1,\n      \"optionId\": 1\n    },\n    {\n      \"questionId\": 2,\n      \"responseText\": \"Excelente metodología pedagógica y acompañamiento continuo.\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Consultar Respuestas Detalladas de la Encuesta",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/surveys/{{surveyId}}/responses"
          }
        },
        {
          "name": "Consultar Estadísticas y Métricas Consolidadas (GET /surveys/:id/statistics)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/surveys/{{surveyId}}/statistics"
          }
        }
      ]
    }
  ]
}
