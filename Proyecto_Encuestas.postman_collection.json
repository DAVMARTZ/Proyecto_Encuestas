    {
      "name": "7. 🚀 Publicar",
      "item": [
        {
          "name": "Obtener IDs para responder",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/surveys/{{surveyId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const encuesta = pm.response.json();",
                  "const pregunta = encuesta.questions.find((q) => q.questionId == pm.collectionVariables.get('questionId'));",
                  "pm.collectionVariables.set('firstOptionId', pregunta.options.find((o) => o.status === 1).optionId.toString());"
                ]
              }
            }
          ]
        },
        {
          "name": "Publicar Encuesta (Activar)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/surveys/{{surveyId}}/publish"
          }
        },
        {
          "name": "Volver a borrador (solo sin respuestas)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/surveys/{{surveyId}}/draft",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "surveys",
                "{{surveyId}}",
                "draft"
              ]
            }
          }
        },
        {
          "name": "Publicar Encuesta de nuevo",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/surveys/{{surveyId}}/publish"
          }
        },
